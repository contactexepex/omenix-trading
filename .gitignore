# The paper accounts, private packs and scoreboard B live in Google Drive (story E2c, owner 15 Oct 2026, "A: move to
# Drive"): the local copies are downloaded for reading only; the public record keeps journal/<book>/daily_totals.csv
journal/*/account/
journal/shadow/*/account/
# Story MS-P1d: the market school's driver accounts, the same Drive-only rule
journal/school/
journal/*/packs/*/private.json
research/scoreboards/B/
research/scoreboards/A/
.ai_book/
.ai_decision/
.ai_decision_observations/

# A daily-run commit that failed, kept for the rerun to commit as recorded (story E2b, decision 47): local only
journal/runs/.pending_commit.json
journal/runs/.pending_commit.json.tmp
journal/runs/.pending_book1.json
journal/runs/.pending_book1.json.tmp
journal/runs/.pending_ai_fire.json
journal/runs/.pending_ai_fire.json.tmp
journal/runs/.parts/
journal/runs/.full/
journal/runs/.own/

# Raw Groww quote files live in Google Drive only (owner, 15 Oct 2026, "6 A"; story A4b): the repository keeps each
# attempt's sidecar and the day's canonical marker
research/data/quotes/groww/**/*.csv

# Story O9b: data moved to Drive (write-once, one receipt per file under receipts/data/); the record scan also
# refuses these paths
research/data/vix/*.csv
research/data/vix/checks/

